rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // IDENTIDADE E FUNÇÕES AUXILIARES
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // ============================================================
    // PERFIL / ROLE (Compatibilidade total com banco legado)
    // ============================================================

    function hasRole(role) {
      return userExists() && (
        (getUserData().keys().hasAny(['role']) && getUserData().role == role) ||
        (getUserData().keys().hasAny(['perfil']) && getUserData().perfil == role) ||
        (getUserData().keys().hasAny(['access_level']) && getUserData().access_level == role) ||
        (getUserData().keys().hasAny(['nivelAcesso']) && getUserData().nivelAcesso == role) ||
        (getUserData().keys().hasAny(['funcao']) && getUserData().funcao == role)
      );
    }

    function isGod() {
      return hasRole('GOD') || hasRole('god');
    }

    function isAdmin() {
      return isGod() 
        || hasRole('ADMINISTRADOR') 
        || hasRole('ADMIN') 
        || hasRole('admin');
    }

    function isLider() {
      return hasRole('LIDER') || hasRole('lider') || hasRole('FRENTE') || hasRole('frente');
    }

    function isSolicitante() {
      return hasRole('SOLICITANTE') || hasRole('solicitante');
    }

    function isMotorista() {
      return hasRole('MOTORISTA') || hasRole('motorista') || hasRole('PRANCHA') || hasRole('prancha');
    }

    function isOwnUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================================
    // PERMISSÕES DE ABAS / MÓDULOS (ARRAY)
    // ============================================================

    function hasPermission(permission) {
      return userExists() 
        && getUserData().keys().hasAny(['permissions'])
        && getUserData().permissions is list
        && getUserData().permissions.hasAny([permission]);
    }

    // GOD e ADMIN possuem acesso total por padrão às abas.
    function canAccess(permission) {
      return isAdmin() || hasPermission(permission);
    }

    // ============================================================
    // PROTEÇÃO CONTRA PROMOÇÃO/ALTERAÇÃO INDEVIDA DE GOD
    // ============================================================

    function creatingGod() {
      return request.resource.data.role in ['GOD', 'god']
        || request.resource.data.perfil in ['GOD', 'god']
        || request.resource.data.access_level in ['GOD', 'god']
        || request.resource.data.nivelAcesso in ['GOD', 'god'];
    }

    function changingToGod() {
      return request.resource.data.role in ['GOD', 'god']
        || request.resource.data.perfil in ['GOD', 'god']
        || request.resource.data.access_level in ['GOD', 'god']
        || request.resource.data.nivelAcesso in ['GOD', 'god'];
    }

    function existingUserIsGod(userId) {
      return exists(/databases/$(database)/documents/usuarios/$(userId))
      && (
        get(/databases/$(database)/documents/usuarios/$(userId)).data.role in ['GOD', 'god']
        || get(/databases/$(database)/documents/usuarios/$(userId)).data.perfil in ['GOD', 'god']
        || get(/databases/$(database)/documents/usuarios/$(userId)).data.access_level in ['GOD', 'god']
        || get(/databases/$(database)/documents/usuarios/$(userId)).data.nivelAcesso in ['GOD', 'god']
      );
    }

    // ============================================================
    // COLEÇÃO: USUÁRIOS (/usuarios)
    // ============================================================

    // Permite lookup de nickname para LOGIN (consulta não autenticada, limitada a 10 docs)
    function isPublicNicknameLookup() {
      return request.auth == null
        && request.method == 'list'
        && request.query != null
        && request.query.limit != null
        && request.query.limit <= 10;
    }

    match /usuarios/{userId} {
      allow read: if (isAuthenticated() && (isOwnUser(userId) || isAdmin()))
        || isPublicNicknameLookup();

      allow create: if isAuthenticated() && (
        (isAdmin() && (isGod() || !creatingGod())) ||
        isOwnUser(userId) // Permite auto-cadastro inicial do usuário
      );

      // O próprio usuário pode atualizar APENAS dados de identidade/sessão
      // (ultimoAcesso/uid/email) — usado pelo fluxo de login.
      // Qualquer alteração de privilégio permanece exclusiva de admins.
      allow update: if (
        (isOwnUser(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcesso', 'uid', 'email']))
      ) || (
        isAdmin() && (isGod() || (!existingUserIsGod(userId) && !changingToGod()))
      );

      allow delete: if isGod();
    }

    // ============================================================
    // COLEÇÃO: FROTAS / PRANCHAS (/frotas e /frota)
    // ============================================================

    // Regra unificada para lidar com /frotas e /frota no singular
    match /frotas/{frotaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isLider() || isMotorista() || canAccess('pranchas');
      allow delete: if isAdmin();
    }

    match /frota/{frotaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isLider() || isMotorista() || canAccess('pranchas');
      allow delete: if isAdmin();
    }

    // ============================================================
    // COLEÇÃO: FRENTES (/frentes)
    // ============================================================

    match /frentes/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isLider() || canAccess('frentes');
      allow delete: if isAdmin();
    }

    // ============================================================
    // COLEÇÃO: EQUIPAMENTOS (/equipamentos)
    // ============================================================

    match /equipamentos/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isLider() || canAccess('equipamentos');
      allow delete: if isAdmin();
    }

    // ============================================================
    // COLEÇÃO: AGENDA (/agenda)
    // ============================================================

    match /agenda/{reservaId} {
      allow read: if isAuthenticated();

      // Permitir agendamento por Admins, Líderes, Solicitantes ou com permissão explícita
      allow create: if isAuthenticated() && (
        isAdmin() || isLider() || isSolicitante() || canAccess('reservas')
      );

      // Permite atualização se for Admin, Líder, Motorista da corrida ou com permissão
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isLider() || 
        isMotorista() || 
        canAccess('reservas') ||
        resource.data.solicitanteId == request.auth.uid ||
        resource.data.criadoPorUid == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ============================================================
    // COLEÇÃO: RELATÓRIOS (/relatorios)
    // ============================================================

    match /relatorios/{relatorioId} {
      allow read: if isAuthenticated() && (canAccess('relatorios') || isLider());

      allow create: if isAuthenticated() && (canAccess('relatorios') || isLider());

      allow update: if isAuthenticated() && (
        isAdmin() || (canAccess('relatorios') && resource.data.userId == request.auth.uid)
      );

      allow delete: if isAdmin();
    }

    // ============================================================
    // COLEÇÃO: AUDITORIA (/audit_logs)
    // ============================================================

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs são estritamente imutáveis
    }

    // ============================================================
    // BLOQUEIO PADRÃO
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}